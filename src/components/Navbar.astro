---
import Logo from "./Logo.astro";
---


<nav
class="
fixed
top-0
z-50
w-full
border-b
border-white/10
bg-[#061426]/70
backdrop-blur-xl
text-white
"
>


<div
class="
mx-auto
flex
max-w-7xl
items-center
justify-between
px-6
py-4
"
>


<!-- LOGO -->

<a href="/">
<Logo />
</a>



<!-- DESKTOP MENU -->

<div
class="
hidden
items-center
gap-8
md:flex
text-sm
tracking-widest
"
>


<a href="/" class="hover:text-[#d4af37] transition">
HOME
</a>


<a href="/about" class="hover:text-[#d4af37] transition">
ABOUT
