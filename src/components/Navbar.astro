---
import Logo from "./Logo.astro";
---

<nav class="w-full border-b border-white/10 bg-[#031126]">
  <div class="mx-auto flex h-[86px] w-full items-center justify-between px-6 md:px-10 lg:px-12">

    <!-- Logo：左侧 -->
    <div class="flex-shrink-0">
      <Logo />
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden items-center md:flex">

      <a
        href="/"
        class="px-5 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
      >
        HOME
      </a>

      <a
        href="/about"
        class="px-5 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
      >
        ABOUT
      </a>

      <a
        href="/services"
        class="px-5 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
      >
        SERVICES
      </a>

      <a
        href="/projects"
        class="px-5 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
      >
        PROJECTS
      </a>

      <a
        href="/contact"
        class="px-5 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
      >
        CONTACT
      </a>

    </div>

    <!-- Mobile Menu Button -->
    <button
      id="menu-btn"
      class="text-3xl text-blue-200 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      ☰
    </button>

  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-[#031126] md:hidden"
  >

    <a
      href="/"
      class="block px-6 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
    >
      HOME
    </a>

    <a
      href="/about"
      class="block px-6 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
    >
      ABOUT
    </a>

    <a
      href="/services"
      class="block px-6 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
    >
      SERVICES
    </a>

    <a
      href="/projects"
      class="block px-6 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
    >
      PROJECTS
    </a>

    <a
      href="/contact"
      class="block px-6 py-4 text-sm tracking-widest text-gray-300 transition hover:text-[#d4af37]"
    >
      CONTACT
    </a>

  </div>
</nav>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");

    const expanded =
      menuBtn.getAttribute("aria-expanded") === "true";

    menuBtn.setAttribute(
      "aria-expanded",
      String(!expanded)
    );
  });
</script>