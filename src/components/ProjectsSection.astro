---
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---


<section
class="
relative
overflow-hidden
bg-[#061426]
py-28
text-white
"
>


<!-- BACKGROUND -->

<div
class="
absolute
inset-0
opacity-10
bg-[linear-gradient(rgba(59,130,246,0.15)_1px,transparent_1px),
linear-gradient(90deg,rgba(59,130,246,0.15)_1px,transparent_1px)]
bg-[size:80px_80px]
"
>
</div>



<div
class="
relative
z-10
mx-auto
max-w-7xl
px-8
"
>


<!-- TITLE -->

<div
class="
mb-16
flex
flex-col
justify-between
gap-6
md:flex-row
md:items-end
"
>


<div>


<p
class="
text-sm
tracking-[0.5em]
text-blue-300
"
>

FEATURED PROJECTS

</p>



<h2
class="
mt-5
text-3xl
font-bold
leading-tight
sm:text-4xl
md:text-6xl
"
>

Our

<span
class="text-[#d4af37]"
>
Projects
</span>

</h2>


</div>



<p
class="
max-w-md
text-gray-300
"
>

Delivering engineering solutions
for landmark projects across ASEAN.

</p>


</div>





<!-- PROJECT LIST -->

<div
class="
space-y-10
"
>


{

projects.map((project) => (


<div
class="
group
overflow-hidden
rounded-2xl
border
border-blue-400/20
bg-white/5
backdrop-blur
"
>


<!-- IMAGE AREA -->


<div
class="
relative
h-[420px]
overflow-hidden
bg-gradient-to-br
from-blue-900
to-[#020617]
"
>


{

project.data.image ? (

<img
src={project.data.image}
alt={project.data.title}
class="
h-full
w-full
object-cover
transition
duration-700
group-hover:scale-105
"
/>


) : (


<div
class="
absolute
inset-0
flex
items-center
justify-center
text-blue-300/40
tracking-widest
"
>

PROJECT IMAGE

</div>


)

}




<!-- SCAN EFFECT -->


<div
class="
absolute
inset-0
bg-gradient-to-r
from-transparent
via-blue-400/10
to-transparent
translate-x-[-100%]
transition
duration-1000
group-hover:translate-x-[100%]
"
>
</div>


</div>





<!-- CONTENT -->


<div
class="
grid
gap-10
p-10
md:grid-cols-2
"
>



<!-- DESCRIPTION -->


<div>


<p
class="
text-sm
tracking-[0.4em]
text-blue-300
"
>

{project.data.location}

</p>




<h3
class="
mt-4
text-3xl
font-bold
"
>

{project.data.title}

</h3>





<p
class="
mt-5
leading-relaxed
text-gray-300
"
>

{project.data.description}

</p>



</div>







<!-- PROJECT DATA -->


<div
class="
grid
grid-cols-2
gap-5
"
>




<div
class="
rounded-lg
border
border-blue-400/20
p-5
"
>

<p
class="
text-3xl
font-bold
text-[#d4af37]
"
>

{project.data.floors}

</p>


<p
class="
mt-2
text-xs
tracking-widest
text-gray-400
"
>

FLOORS

</p>


</div>







<div
class="
rounded-lg
border
border-blue-400/20
p-5
"
>

<p
class="
text-3xl
font-bold
text-[#d4af37]
"
>

{project.data.area}

</p>


<p
class="
mt-2
text-xs
tracking-widest
text-gray-400
"
>

AREA

</p>


</div>







<div
class="
rounded-lg
border
border-blue-400/20
p-5
"
>

<p
class="
text-3xl
font-bold
text-[#d4af37]
"
>

{project.data.system}

</p>


<p
class="
mt-2
text-xs
tracking-widest
text-gray-400
"
>

SYSTEM

</p>


</div>







<div
class="
rounded-lg
border
border-blue-400/20
p-5
"
>

<p
class="
text-3xl
font-bold
text-[#d4af37]
"
>

{project.data.year}

</p>


<p
class="
mt-2
text-xs
tracking-widest
text-gray-400
"
>

PROJECT

</p>


</div>





</div>


</div>


</div>


))


}


</div>



</div>


</section>