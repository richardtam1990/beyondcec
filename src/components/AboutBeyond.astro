---
const { data } = Astro.props;
---

<section
class="
relative
overflow-hidden
bg-[#061426]
py-28
text-white
">


<!-- BACKGROUND GRID -->

<div
class="
absolute
inset-0
opacity-10
bg-[linear-gradient(rgba(59,130,246,0.15)_1px,transparent_1px),
linear-gradient(90deg,rgba(59,130,246,0.15)_1px,transparent_1px)]
bg-[size:80px_80px]
">
</div>



<!-- BLUE LIGHT -->

<div
class="
absolute
right-0
top-1/2
h-[500px]
w-[500px]
-translate-y-1/2
rounded-full
bg-blue-500/20
blur-[120px]
">
</div>





<div
class="
relative
z-10
mx-auto
max-w-7xl
px-8
">


<div
class="
grid
items-center
gap-16
lg:grid-cols-2
">



<!-- LEFT CONTENT -->

<div>


