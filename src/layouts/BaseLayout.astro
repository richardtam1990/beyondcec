---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";


const {
  title = "BEYOND Construction Engineering",
  description = "BEYOND Construction Engineering Co., Ltd. Professional construction engineering, MEP installation and architectural lighting solutions in Laos and ASEAN."
} = Astro.props;

---


<!doctype html>

<html lang="en">


<head>


<meta charset="UTF-8" />


<meta
name="viewport"
content="width=device-width, initial-scale=1"
/>



<title>
{title}
</title>



<!-- FAVICON -->

<link
rel="icon"
type="image/png"
href="/favicon.png"
/>



<!-- SEO DESCRIPTION -->

<meta
name="description"
content={description}
/>



<meta
name="keywords"
content="
construction engineering,
Laos construction,
MEP installation,
architectural lighting,
facade lighting,
ASEAN engineering
"
/>



<!-- MOBILE THEME -->

<meta
name="theme-color"
content="#020617"
/>



</head>





<body
class="
overflow-x-hidden
bg-[#020617]
text-white
"
>



<Navbar />



<main>

<slot />

</main>



<Footer />



</body>


</html>