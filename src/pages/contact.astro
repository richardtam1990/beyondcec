---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | BEYOND Construction Engineering">


<section
class="
min-h-screen
overflow-x-hidden
bg-[#020617]
px-6
py-28
text-white
"
>


<div
class="
mx-auto
max-w-7xl
"
>



<!-- HEADER -->

<div
class="
mx-auto
max-w-3xl
text-center
"
>


<p
class="
text-sm
tracking-[0.35em]
text-[#d4af37]
"
>
CONTACT BEYOND
</p>



<h1
class="
mt-5
break-words
text-4xl
font-bold
leading-tight
sm:text-5xl
md:text-6xl
"
>

Let's Build Beyond&nbsp;

<span
class="text-[#d4af37]"
>
Boundaries
</span>


</h1>



<p
class="
mt-6
text-base
leading-relaxed
text-gray-300
sm:text-lg
"
>

Tell us about your project and let's explore
how BEYOND can help turn your vision into reality.

</p>



</div>






<!-- CONTENT -->

<div
class="
mt-16
grid
gap-10
lg:grid-cols-2
"
>




<!-- COMPANY INFO -->


<div
class="
rounded-2xl
border
border-blue-400/20
bg-slate-900/70
p-7
sm:p-10
"
>


<p
class="
text-sm
tracking-[0.3em]
text-blue-300
"
>
BEYOND CONSTRUCTION
</p>



<h2
class="
mt-5
text-3xl
font-bold
leading-tight
sm:text-4xl
"
>

Engineering

<br/>

<span
class="text-[#d4af37]"
>
Beyond
</span>


</h2>




<div
class="
mt-10
space-y-8
text-gray-300
"
>



<div>

<h3
class="
text-sm
font-semibold
tracking-widest
text-white
"
>
COMPANY
</h3>


<p
class="mt-2"
>
BEYOND Construction Engineering Co., Ltd.
</p>


</div>






<div>

<h3
class="
text-sm
font-semibold
tracking-widest
text-white
"
>
LOCATION
</h3>


<p
class="mt-2"
>
Vientiane Capital, Laos
</p>


</div>







<div>

<h3
class="
text-sm
font-semibold
tracking-widest
text-white
"
>
EMAIL
</h3>


<a
href="mailto:info@beyondcec.com"
class="
mt-2
block
text-blue-400
hover:text-[#d4af37]
transition
"
>
info@beyondcec.com
</a>


</div>







<div>

<h3
class="
text-sm
font-semibold
tracking-widest
text-white
"
>
BUSINESS AREAS
</h3>


<p
class="
mt-2
leading-relaxed
"
>

Construction Engineering,
Building Installation,
Exterior Lighting,
Industrial Engineering

</p>


</div>




</div>



</div>








<!-- FORM -->


<div
class="
rounded-2xl
border
border-blue-400/20
bg-slate-900/70
p-7
sm:p-10
"
>


<p
class="
text-sm
tracking-[0.3em]
text-blue-300
"
>
PROJECT INQUIRY
</p>




<h2
class="
mt-5
text-3xl
font-bold
"
>
Send Message
</h2>





<form

action="https://formspree.io/f/mnpanozg"

method="POST"

class="
mt-8
space-y-6
"

>





<input

type="text"

name="name"

required

placeholder="Your Name"

class="
w-full
rounded-lg
border
border-white/10
bg-slate-800
px-5
py-4
text-white
outline-none
focus:ring-2
focus:ring-[#d4af37]
"

/>






<input

type="email"

name="email"

required

placeholder="Email Address"

class="
w-full
rounded-lg
border
border-white/10
bg-slate-800
px-5
py-4
text-white
outline-none
focus:ring-2
focus:ring-[#d4af37]
"

/>






<input

type="text"

name="company"

placeholder="Company Name"

class="
w-full
rounded-lg
border
border-white/10
bg-slate-800
px-5
py-4
text-white
outline-none
focus:ring-2
focus:ring-[#d4af37]
"

/>







<select

name="project_type"

class="
w-full
rounded-lg
border
border-white/10
bg-slate-800
px-5
py-4
text-white
outline-none
focus:ring-2
focus:ring-[#d4af37]
"

>


<option>
Project Type
</option>


<option>
Construction Engineering
</option>


<option>
MEP Installation
</option>


<option>
Architectural Lighting
</option>


<option>
Infrastructure
</option>



</select>







<textarea

name="message"

rows="6"

required

placeholder="Project Details"

class="
w-full
resize-none
rounded-lg
border
border-white/10
bg-slate-800
px-5
py-4
text-white
outline-none
focus:ring-2
focus:ring-[#d4af37]
"

></textarea>







<input

type="hidden"

name="_subject"

value="New BEYOND Construction Project Inquiry"

/>







<button

type="submit"

class="
w-full
rounded-lg
bg-[#d4af37]
px-8
py-4
font-bold
text-black
transition
hover:bg-yellow-300
"

>

Send Inquiry

</button>





</form>





</div>





</div>





</div>


</section>


</BaseLayout>