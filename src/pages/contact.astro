---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | BEYOND CONSTRUCTION">

<section class="min-h-screen bg-slate-950 text-white py-20">

  <div class="max-w-7xl mx-auto px-8">

    <!-- Header -->
    <div class="text-center mb-16">

      <h1 class="text-5xl font-bold text-blue-400">
        Contact Us
      </h1>

      <p class="mt-6 text-xl text-gray-300">
        Let's Build Beyond Boundaries Together
      </p>

    </div>



    <div class="grid md:grid-cols-2 gap-12">


      <!-- Company Information -->
      <div class="bg-slate-900 rounded-xl p-10 border border-slate-800">


        <h2 class="text-3xl font-bold text-yellow-400 mb-8">
          BEYOND Construction Engineering
        </h2>


        <div class="space-y-6 text-gray-300">


          <div>
            <h3 class="text-white font-semibold text-lg">
              Company
            </h3>

            <p class="mt-2">
              BEYOND Construction Engineering Co., Ltd.
            </p>
          </div>



          <div>
            <h3 class="text-white font-semibold text-lg">
              Location
            </h3>

            <p class="mt-2">
              Vientiane Capital, Laos
            </p>
          </div>



          <div>
            <h3 class="text-white font-semibold text-lg">
              Email
            </h3>

            <p class="mt-2 text-blue-400">
              info@beyondcec.com
            </p>
          </div>



          <div>
            <h3 class="text-white font-semibold text-lg">
              Business Areas
            </h3>

            <p class="mt-2">
              Construction Engineering,
              Building Installation,
              Exterior Lighting,
              Industrial Engineering
            </p>
          </div>


        </div>


      </div>




      <!-- Contact Form -->
      <div class="bg-slate-900 rounded-xl p-10 border border-slate-800">


        <h2 class="text-3xl font-bold mb-8">
          Send Message
        </h2>



        <form class="space-y-6">


          <input
            type="text"
            placeholder="Your Name"
            class="w-full bg-slate-800 rounded-lg px-5 py-4 outline-none focus:ring-2 focus:ring-yellow-400"
          />



          <input
            type="email"
            placeholder="Email Address"
            class="w-full bg-slate-800 rounded-lg px-5 py-4 outline-none focus:ring-2 focus:ring-yellow-400"
          />



          <input
            type="text"
            placeholder="Company Name"
            class="w-full bg-slate-800 rounded-lg px-5 py-4 outline-none focus:ring-2 focus:ring-yellow-400"
          />



          <textarea
            rows="5"
            placeholder="Your Message"
            class="w-full bg-slate-800 rounded-lg px-5 py-4 outline-none focus:ring-2 focus:ring-yellow-400"
          ></textarea>



          <button
            type="submit"
            class="bg-yellow-400 text-black font-bold px-8 py-4 rounded-lg hover:bg-yellow-300 transition"
          >
            Send Inquiry
          </button>


        </form>


      </div>


    </div>


  </div>


</section>


</BaseLayout>