---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);

const images = project.data.images ?? [];
---

<BaseLayout title={`${project.data.title} | BEYOND CONSTRUCTION`}>

  <!-- ========================================= -->
  <!-- HERO -->
  <!-- ========================================= -->

  <section class="pt-24 sm:pt-28 pb-12 px-6">

    <div class="max-w-7xl mx-auto">

      <!-- Back -->

      <a
        href="/projects/"
        class="inline-flex items-center gap-2 text-sm text-blue-400 hover:text-yellow-400 transition"
      >
        ← Back to Projects
      </a>


      <!-- Category -->

      <p class="mt-10 text-xs sm:text-sm tracking-[0.3em] uppercase text-yellow-400">
        {project.data.category}
      </p>


      <!-- Title -->

      <h1 class="mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight">
        {project.data.title}
      </h1>


      <!-- Location -->

      <p class="mt-5 text-base sm:text-lg text-blue-400">
        {project.data.location}
      </p>

    </div>

  </section>


  <!-- ========================================= -->
  <!-- PROJECT GALLERY -->
  <!-- ========================================= -->

  <section class="px-6 pb-20">

    <div class="max-w-7xl mx-auto">

      {
        images.length > 0 ? (

          <div class="space-y-4">

            <!-- MAIN IMAGE -->

            <a
              href={images[0]}
              target="_blank"
              rel="noopener noreferrer"
              class="group block relative overflow-hidden rounded-2xl bg-slate-900 border border-slate-800"
            >

              <div class="aspect-[16/9] sm:aspect-[21/9]">

                <img
                  src={images[0]}
                  alt={project.data.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="eager"
                />

              </div>


              <!-- Overlay -->

              <div
                class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition duration-500"
              ></div>


              <div
                class="absolute bottom-5 right-5 px-4 py-2 rounded-full bg-black/60 backdrop-blur text-xs text-white opacity-0 group-hover:opacity-100 transition"
              >
                View Image
              </div>

            </a>


            <!-- THUMBNAILS -->

            {
              images.length > 1 && (

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

                  {
                    images.slice(1).map((image, index) => (

                      <a
                        href={image}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative block aspect-[4/3] overflow-hidden rounded-xl bg-slate-900 border border-slate-800 hover:border-yellow-400 transition"
                      >

                        <img
                          src={image}
                          alt={`${project.data.title} - Image ${index + 2}`}
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                          loading="lazy"
                        />

                        <div
                          class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition"
                        ></div>

                      </a>

                    ))
                  }

                </div>

              )
            }

          </div>

        ) : (

          <div class="aspect-video bg-slate-900 rounded-2xl border border-slate-800 flex items-center justify-center">

            <span class="text-gray-500">
              No project images available
            </span>

          </div>

        )
      }

    </div>

  </section>


  <!-- ========================================= -->
  <!-- PROJECT CONTENT -->
  <!-- ========================================= -->

  <section class="px-6 pb-24">

    <div class="max-w-7xl mx-auto grid lg:grid-cols-3 gap-10 lg:gap-16">


      <!-- ===================================== -->
      <!-- LEFT CONTENT -->
      <!-- ===================================== -->

      <div class="lg:col-span-2">

        <p class="text-xs sm:text-sm uppercase tracking-[0.3em] text-yellow-400">
          Project Overview
        </p>


        <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-white">
          Engineering Beyond Expectations
        </h2>


        <div class="mt-7 text-gray-300 leading-relaxed text-base sm:text-lg">

          <p>
            {project.data.description}
          </p>


          <!-- Markdown Content -->

          <div class="mt-8 prose prose-invert max-w-none">

            <Content />

          </div>

        </div>

      </div>


      <!-- ===================================== -->
      <!-- PROJECT INFORMATION -->
      <!-- ===================================== -->

      <aside>

        <div
          class="lg:sticky lg:top-24 rounded-2xl border border-slate-800 bg-slate-900/90 p-7 sm:p-8"
        >

          <p class="text-xs uppercase tracking-[0.25em] text-yellow-400">
            Project Information
          </p>


          <div class="mt-7 divide-y divide-slate-800">


            <!-- Location -->

            <div class="py-4 first:pt-0">

              <span class="block text-xs uppercase tracking-wider text-gray-500">
                Location
              </span>

              <span class="block mt-2 text-gray-200">
                {project.data.location}
              </span>

            </div>


            <!-- Category -->

            <div class="py-4">

              <span class="block text-xs uppercase tracking-wider text-gray-500">
                Category
              </span>

              <span class="block mt-2 text-gray-200">
                {project.data.category}
              </span>

            </div>


            <!-- System -->

            <div class="py-4">

              <span class="block text-xs uppercase tracking-wider text-gray-500">
                System
              </span>

              <span class="block mt-2 text-gray-200">
                {project.data.system}
              </span>

            </div>


            <!-- Year -->

            <div class="py-4">

              <span class="block text-xs uppercase tracking-wider text-gray-500">
                Year
              </span>

              <span class="block mt-2 text-gray-200">
                {project.data.year}
              </span>

            </div>


            <!-- Floors -->

            <div class="py-4">

              <span class="block text-xs uppercase tracking-wider text-gray-500">
                Floors
              </span>

              <span class="block mt-2 text-gray-200">
                {project.data.floors}
              </span>

            </div>


            <!-- Area -->

            <div class="py-4 last:pb-0">

              <span class="block text-xs uppercase tracking-wider text-gray-500">
                Area
              </span>

              <span class="block mt-2 text-gray-200">
                {project.data.area}
              </span>

            </div>


          </div>

        </div>

      </aside>

    </div>

  </section>


  <!-- ========================================= -->
  <!-- BACK TO PROJECTS -->
  <!-- ========================================= -->

  <section class="px-6 pb-24">

    <div class="max-w-7xl mx-auto border-t border-slate-800 pt-10">

      <a
        href="/projects/"
        class="inline-flex items-center gap-3 text-blue-400 hover:text-yellow-400 transition"
      >
        <span>←</span>
        <span>Back to All Projects</span>
      </a>

    </div>

  </section>

</BaseLayout>