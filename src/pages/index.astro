---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="BEYOND CONSTRUCTION | International Construction Engineering">

<section class="min-h-screen bg-slate-950 text-white">

  <!-- Hero Section -->
  <div class="min-h-screen flex items-center justify-center px-8">

    <div class="text-center max-w-5xl">

      <h1 class="text-6xl md:text-7xl font-bold text-blue-400">
        BEYOND CONSTRUCTION
      </h1>


      <p class="mt-8 text-2xl text-gray-300">
        Building Beyond Boundaries
      </p>


      <p class="mt-4 text-lg text-gray-400">
        International Construction Engineering Solutions
      </p>


      <a
        href="/projects"
        class="inline-block mt-10 bg-yellow-400 text-black font-bold px-10 py-4 rounded-lg hover:bg-yellow-300 transition"
      >
        View Projects
      </a>

    </div>

  </div>




  <!-- About Section -->
  <section class="py-20 bg-slate-900">

    <div class="max-w-6xl mx-auto px-8 text-center">


      <h2 class="text-4xl font-bold text-blue-400">
        Engineering Excellence Across Southeast Asia
      </h2>


      <p class="mt-8 text-xl text-gray-300 leading-relaxed">

        BEYOND Construction Engineering Co., Ltd.
        provides professional construction,
        installation and engineering solutions
        for commercial and industrial projects.

      </p>


    </div>

  </section>





  <!-- Services Section -->
  <section class="py-20 bg-slate-950">

    <div class="max-w-7xl mx-auto px-8">


      <h2 class="text-4xl font-bold text-center text-blue-400">
        Our Services
      </h2>


      <div class="grid md:grid-cols-4 gap-8 mt-12">


        <div class="bg-slate-900 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-yellow-400">
            Construction
          </h3>
          <p class="mt-4 text-gray-300">
            Professional construction engineering and project execution.
          </p>
        </div>



        <div class="bg-slate-900 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-yellow-400">
            Installation
          </h3>
          <p class="mt-4 text-gray-300">
            Building systems installation and technical solutions.
          </p>
        </div>



        <div class="bg-slate-900 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-yellow-400">
            Exterior Lighting
          </h3>
          <p class="mt-4 text-gray-300">
            Architectural lighting design and LED engineering.
          </p>
        </div>



        <div class="bg-slate-900 p-8 rounded-xl">
          <h3 class="text-xl font-bold text-yellow-400">
            Industrial Engineering
          </h3>
          <p class="mt-4 text-gray-300">
            Equipment installation and industrial solutions.
          </p>
        </div>


      </div>

    </div>

  </section>






  <!-- Projects Section -->
  <section class="py-20 bg-slate-900">

    <div class="max-w-6xl mx-auto px-8 text-center">


      <h2 class="text-4xl font-bold text-blue-400">
        Featured Project
      </h2>


      <h3 class="mt-10 text-3xl font-bold">
        Unitel Headquarters Building
      </h3>


      <p class="mt-4 text-xl text-gray-300">
        Vientiane, Laos
      </p>


      <p class="mt-6 text-gray-400">
        Exterior Lighting Engineering Project
        including LED lighting systems,
        installation and intelligent control solutions.
      </p>


      <a
        href="/projects"
        class="inline-block mt-8 border border-yellow-400 text-yellow-400 px-8 py-3 rounded-lg hover:bg-yellow-400 hover:text-black transition"
      >
        Explore Projects
      </a>


    </div>

  </section>






  <!-- Contact Section -->
  <section class="py-20 bg-slate-950">

    <div class="max-w-5xl mx-auto px-8 text-center">


      <h2 class="text-4xl font-bold text-blue-400">
        Let's Build Beyond Boundaries
      </h2>


      <p class="mt-6 text-gray-300 text-xl">
        Partner with BEYOND Construction Engineering
      </p>


      <a
        href="/contact"
        class="inline-block mt-8 bg-yellow-400 text-black font-bold px-10 py-4 rounded-lg"
      >
        Contact Us
      </a>


    </div>

  </section>


</section>


</BaseLayout>