---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConstructionScan from "../components/ConstructionScan.astro";
---


<BaseLayout>


<!-- ================= HERO ================= -->


<section class="relative min-h-screen overflow-hidden bg-[#020617] text-white">


  <!-- HERO BACKGROUND IMAGE -->

  <div class="absolute inset-0 z-0">


    <img
      src="/construction-bg.jpg"
      alt="BEYOND Construction"
      class="h-full w-full object-cover scale-105"
    />


  </div>



  <!-- DARK OVERLAY -->


<!-- DARK OVERLAY -->

<div class="absolute inset-0 z-0 
bg-gradient-to-b
from-blue-950/40
via-[#020617]/50
to-[#020617]/90">
</div>




  <!-- V3 BUILDING SCAN -->


  <div class="absolute inset-0 z-[1]">

    <ConstructionScan />

  </div>





  <!-- HERO CONTENT -->


  <div class="relative z-10 flex min-h-screen items-center">


    <div class="mx-auto w-full max-w-7xl px-8">



      <p class="mb-5 text-sm tracking-[0.5em] text-blue-300">

        INTERNATIONAL ENGINEERING GROUP

      </p>





      <h1 class="max-w-4xl text-6xl font-bold leading-tight md:text-7xl">


        Building Beyond

        <br />

        Boundaries


      </h1>





      <h2 class="mt-8 text-3xl text-slate-300">

        Engineering The Future

      </h2>





      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-300">


        Delivering integrated construction,
        engineering and infrastructure solutions
        across Southeast Asia.


      </p>





      <div class="mt-12 flex gap-5">



        <a
        href="/projects"
        class="
        rounded-md
        bg-yellow-500
        px-9
        py-4
        font-semibold
        text-black
        transition
        hover:bg-yellow-400">


        View Projects


        </a>






        <a
        href="/contact"
        class="
        rounded-md
        border
        border-white/40
        px-9
        py-4
        transition
        hover:bg-white
        hover:text-black">


        Get In Touch


        </a>




      </div>




    </div>



  </div>





  <!-- SCROLL -->


  <div class="absolute bottom-10 left-1/2 z-10 -translate-x-1/2">


    <span class="text-xs tracking-[0.6em] text-slate-400">

      SCROLL

    </span>


  </div>




</section>







<!-- ================= ABOUT BEYOND ================= -->



<section class="bg-white py-24">


<div class="mx-auto max-w-7xl px-8">



  <p class="text-sm tracking-[0.4em] text-blue-700">

    ABOUT BEYOND

  </p>





  <h2 class="mt-5 text-5xl font-bold text-slate-900">


    Building Beyond Boundaries


  </h2>





  <p class="mt-8 max-w-3xl text-lg leading-relaxed text-slate-600">


    BEYOND CONSTRUCTION ENGINEERING CO., LTD
    is an international construction engineering company
    providing integrated solutions in construction,
    engineering and infrastructure development.



  </p>







  <div class="mt-16 grid gap-8 md:grid-cols-3">






    <div class="rounded-xl bg-slate-50 p-10 shadow">


      <h3 class="text-5xl font-bold text-blue-900">

        10+

      </h3>


      <p class="mt-3 text-slate-600">

        Years Experience

      </p>


    </div>







    <div class="rounded-xl bg-slate-50 p-10 shadow">


      <h3 class="text-5xl font-bold text-blue-900">

        20+

      </h3>


      <p class="mt-3 text-slate-600">

        Engineering Projects

      </p>


    </div>







    <div class="rounded-xl bg-slate-50 p-10 shadow">


      <h3 class="text-5xl font-bold text-blue-900">

        3+

      </h3>


      <p class="mt-3 text-slate-600">

        Countries Connected

      </p>


    </div>





  </div>




</div>


</section>




</BaseLayout>