---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConstructionScan from "../components/ConstructionScan.astro";
import AboutBeyond from "../components/AboutBeyond.astro";
import ServicesSection from "../components/ServicesSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import WhyChooseBeyond from "../components/WhyChooseBeyond.astro";
import PartnersSection from "../components/PartnersSection.astro";
import ContactCTA from "../components/ContactCTA.astro";

import { getEntry } from "astro:content";

const homepage = await getEntry("homepage", "index");

const data = homepage?.data;

console.log("HOMEPAGE:", homepage);
console.log("DATA:", data);
---


<BaseLayout>


<!-- ================= HERO ================= -->


<section
class="
relative
min-h-screen
overflow-hidden
bg-[#061426]
"
>


<!-- REAL BUILDING BACKGROUND -->

<div
class="
absolute
inset-0
z-0
bg-[url('/images/construction-bg.jpg')]
bg-cover
bg-center
scale-105
"
>
</div>



<!-- DARK BLUE OVERLAY -->

<div
class="
absolute
inset-0
bg-gradient-to-r
from-[#020617]
via-[#061426]/90
to-[#061426]/60
">
</div>



<!-- BOTTOM FADE -->

<div
class="
absolute
inset-0
bg-gradient-to-t
from-[#061426]
via-transparent
to-transparent
">
</div>




<!-- BIM SCAN -->

<div
class="
absolute
inset-0
z-10
"
>

<ConstructionScan data={data} />

</div>



<!-- BLUE GLASS EFFECT -->

<div
class="
absolute
inset-0
z-15
bg-blue-500/5
backdrop-blur-[1px]
"
>
</div>




<!-- HERO CONTENT -->


<div
class="
relative
z-20
mx-auto
flex
min-h-screen
max-w-7xl
items-center
px-6
md:px-8
">


<div
class="
max-w-4xl
">


<p
class="
mb-6
text-sm
tracking-[0.6em]
text-blue-300
">

BEYOND CONSTRUCTION ENGINEERING

</p>



<h1
class="
max-w-full
break-words
text-4xl
font-bold
leading-[1.05]
tracking-tight
sm:text-6xl
md:text-8xl
"
>

BUILDING

<br/>


<span
class="
bg-gradient-to-r
from-[#ffffff]
via-[#d4af37]
to-[#ffffff]
bg-clip-text
text-transparent
">

BEYOND

</span>


BOUNDARIES


</h1>



<p
class="
mt-8
max-w-xl
text-lg
leading-relaxed
text-gray-300
"
>

International Construction Engineering.

<br />

Building infrastructure,
creating landmarks,
and connecting the future.

</p>



<div
class="
mt-12
flex
flex-col
gap-4
sm:flex-row
sm:gap-6
">


<a
href="/projects"
class="
group
relative
overflow-hidden
rounded-md
bg-[#d4af37]
px-10
py-5
font-semibold
text-black
"
>

<span
class="
relative
z-10
">

VIEW PROJECTS

</span>


</a>



<a
href="/contact"
class="
rounded
border
border-white/30
px-8
py-4
hover:bg-white/10
">

Contact Us

</a>



</div>



</div>


</div>




<!-- SCROLL -->


<div
class="
absolute
bottom-10
left-1/2
z-20
-translate-x-1/2
text-xs
tracking-[0.5em]
text-blue-300
">

SCROLL

</div>



</section>


<AboutBeyond data={data} />

<ServicesSection />

<ProjectsSection />

<WhyChooseBeyond />

<PartnersSection />

<ContactCTA />




</BaseLayout>