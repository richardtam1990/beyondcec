---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<section class="min-h-screen bg-slate-950 text-white">

  <header class="flex justify-between items-center p-8">
    <div class="text-2xl font-bold text-blue-400">
      BEYOND CEC
    </div>

    <nav>
      <a class="mx-3">Home</a>
      <a class="mx-3">About</a>
      <a class="mx-3">Services</a>
      <a class="mx-3">Projects</a>
      <a class="mx-3">Contact</a>
    </nav>
  </header>


  <main class="text-center mt-32">

    <h1 class="text-6xl font-bold">
      Building Beyond Boundaries
    </h1>

    <p class="mt-6 text-xl">
      International Construction Engineering
    </p>

    <button class="mt-10 bg-yellow-500 px-8 py-3 rounded-lg text-black">
      View Projects
    </button>

  </main>

</section>

</BaseLayout> 