---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout title="Projects | BEYOND CONSTRUCTION">

  <div class="text-center mb-16">

    <h1 class="text-5xl font-bold text-blue-400">
      Our Projects
    </h1>

    <p class="mt-6 text-xl text-gray-300">
      Delivering Professional Engineering Solutions Across Southeast Asia
    </p>

  </div>


  <!-- Projects Grid -->

  <div class="grid md:grid-cols-2 gap-10">

    {
      projects.map((project, index) => (

        <div
          class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-yellow-400 transition"
        >

          <!-- Project Image -->

          <div class="h-64 bg-slate-800 overflow-hidden">

            {
              project.data.image ? (

                <img
                  src={project.data.image}
                  alt={project.data.title}
                  class="w-full h-full object-cover"
                />

              ) : (

                <div class="h-full flex items-center justify-center">

                  <span class="text-gray-500 text-xl">
                    Project Image
                  </span>

                </div>

              )
            }

          </div>


          <!-- Project Content -->

          <div class="p-8">

            <!-- Project Number -->

            <div class="text-yellow-400 text-4xl font-bold mb-4">

              {String(index + 1).padStart(2, "0")}

            </div>


            <!-- Title -->

            <h2 class="text-3xl font-bold text-white">

              {project.data.title}

            </h2>


            <!-- Location -->

            <p class="mt-3 text-blue-400">

              {project.data.location}

            </p>


            <!-- Description -->

            <p class="mt-6 text-gray-300 leading-relaxed">

              {project.data.description}

            </p>


            <!-- Project Information -->

            <div class="mt-6 space-y-2 text-gray-400">


              <p>

                <span class="text-yellow-400">
                  Category:
                </span>

                {project.data.category}

              </p>


              <p>

                <span class="text-yellow-400">
                  System:
                </span>

                {project.data.system}

              </p>


              <p>

                <span class="text-yellow-400">
                  Location:
                </span>

                {project.data.location}

              </p>


              <p>

                <span class="text-yellow-400">
                  Year:
                </span>

                {project.data.year}

              </p>


              <p>

                <span class="text-yellow-400">
                  Floors:
                </span>

                {project.data.floors}

              </p>


              <p>

                <span class="text-yellow-400">
                  Area:
                </span>

                {project.data.area}

              </p>

            </div>

          </div>

        </div>

      ))
    }

  </div>

</BaseLayout>