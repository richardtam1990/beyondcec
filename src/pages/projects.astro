---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | BEYOND CONSTRUCTION">

<section class="min-h-screen bg-slate-950 text-white py-20">

  <div class="max-w-7xl mx-auto px-8">

    <!-- Header -->
    <div class="text-center mb-16">

      <h1 class="text-5xl font-bold text-blue-400">
        Our Projects
      </h1>

      <p class="mt-6 text-xl text-gray-300">
        Delivering Professional Engineering Solutions Across Southeast Asia
      </p>

    </div>


    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 gap-10">


      <!-- Project 01 -->
      <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-yellow-400 transition">


        <div class="h-64 bg-slate-800 flex items-center justify-center">

          <span class="text-gray-500 text-xl">
            Project Image
          </span>

        </div>


        <div class="p-8">

          <div class="text-yellow-400 text-4xl font-bold mb-4">
            01
          </div>


          <h2 class="text-3xl font-bold">
            Unitel Headquarters Building
          </h2>


          <p class="mt-3 text-blue-400">
            Vientiane, Laos
          </p>


          <p class="mt-6 text-gray-300 leading-relaxed">

            Exterior Lighting Engineering Project
            including architectural lighting design,
            LED lighting system installation and
            intelligent lighting control solutions.

          </p>


          <div class="mt-6 space-y-2 text-gray-400">

            <p>
              <span class="text-yellow-400">
              Scope:
              </span>
              Exterior Lighting Design & Installation
            </p>


            <p>
              <span class="text-yellow-400">
              System:
              </span>
              LED Lighting / DMX512 Control
            </p>


            <p>
              <span class="text-yellow-400">
              Location:
              </span>
              Vientiane Capital, Laos
            </p>

          </div>


        </div>

      </div>




      <!-- Project 02 -->
      <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-yellow-400 transition">


        <div class="h-64 bg-slate-800 flex items-center justify-center">

          <span class="text-gray-500 text-xl">
            Project Image
          </span>

        </div>


        <div class="p-8">


          <div class="text-yellow-400 text-4xl font-bold mb-4">
            02
          </div>


          <h2 class="text-3xl font-bold">
            Commercial Building Engineering
          </h2>


          <p class="mt-3 text-blue-400">
            Southeast Asia
          </p>


          <p class="mt-6 text-gray-300 leading-relaxed">

            Integrated engineering services
            including construction support,
            building installation and technical
            project management.

          </p>


        </div>

      </div>




      <!-- Project 03 -->
      <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-yellow-400 transition">


        <div class="h-64 bg-slate-800 flex items-center justify-center">

          <span class="text-gray-500 text-xl">
            Project Image
          </span>

        </div>


        <div class="p-8">


          <div class="text-yellow-400 text-4xl font-bold mb-4">
            03
          </div>


          <h2 class="text-3xl font-bold">
            Industrial Equipment Installation
          </h2>


          <p class="mt-3 text-blue-400">
            Industrial Engineering
          </p>


          <p class="mt-6 text-gray-300 leading-relaxed">

            Professional installation and
            integration services for industrial
            equipment and engineering systems.

          </p>


        </div>

      </div>




      <!-- Project 04 -->
      <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-yellow-400 transition">


        <div class="h-64 bg-slate-800 flex items-center justify-center">

          <span class="text-gray-500 text-xl">
            Project Image
          </span>

        </div>


        <div class="p-8">


          <div class="text-yellow-400 text-4xl font-bold mb-4">
            04
          </div>


          <h2 class="text-3xl font-bold">
            Future Engineering Projects
          </h2>


          <p class="mt-3 text-blue-400">
            Coming Soon
          </p>


          <p class="mt-6 text-gray-300 leading-relaxed">

            Expanding engineering capabilities
            and delivering innovative solutions
            for international partners.

          </p>


        </div>

      </div>


    </div>


  </div>

</section>


</BaseLayout>