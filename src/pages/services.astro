---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Services | BEYOND CONSTRUCTION">

<section class="min-h-screen bg-slate-950 text-white py-20">

  <div class="max-w-7xl mx-auto px-8">

    <!-- Header -->
    <div class="text-center mb-16">

      <h1 class="text-5xl font-bold text-blue-400">
        Our Services
      </h1>

      <p class="mt-6 text-xl text-gray-300">
        Professional Engineering Solutions Across Southeast Asia
      </p>

    </div>


    <!-- Services Grid -->
    <div class="grid md:grid-cols-3 gap-8">


      <!-- Service 1 -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-800 hover:border-yellow-400 transition">

        <div class="text-yellow-400 text-4xl mb-6">
          01
        </div>

        <h2 class="text-2xl font-bold">
          Construction Engineering
        </h2>

        <p class="mt-4 text-gray-300 leading-relaxed">
          Providing comprehensive construction solutions
          including project execution, site management,
          and engineering coordination.
        </p>

      </div>



      <!-- Service 2 -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-800 hover:border-yellow-400 transition">

        <div class="text-yellow-400 text-4xl mb-6">
          02
        </div>

        <h2 class="text-2xl font-bold">
          Building Installation
        </h2>

        <p class="mt-4 text-gray-300 leading-relaxed">
          Professional installation services covering
          electrical systems, mechanical equipment,
          and building infrastructure.
        </p>

      </div>



      <!-- Service 3 -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-800 hover:border-yellow-400 transition">

        <div class="text-yellow-400 text-4xl mb-6">
          03
        </div>

        <h2 class="text-2xl font-bold">
          Exterior Lighting Engineering
        </h2>

        <p class="mt-4 text-gray-300 leading-relaxed">
          Architectural lighting design,
          LED systems, control solutions,
          and large-scale facade lighting projects.
        </p>

      </div>



      <!-- Service 4 -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-800 hover:border-yellow-400 transition">

        <div class="text-yellow-400 text-4xl mb-6">
          04
        </div>

        <h2 class="text-2xl font-bold">
          Industrial Equipment Installation
        </h2>

        <p class="mt-4 text-gray-300 leading-relaxed">
          Industrial machinery installation,
          equipment integration,
          and technical engineering support.
        </p>

      </div>



      <!-- Service 5 -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-800 hover:border-yellow-400 transition">

        <div class="text-yellow-400 text-4xl mb-6">
          05
        </div>

        <h2 class="text-2xl font-bold">
          Project Management
        </h2>

        <p class="mt-4 text-gray-300 leading-relaxed">
          Professional project planning,
          cost control,
          and quality management.
        </p>

      </div>



      <!-- Service 6 -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-800 hover:border-yellow-400 transition">

        <div class="text-yellow-400 text-4xl mb-6">
          06
        </div>

        <h2 class="text-2xl font-bold">
          Technical Consulting
        </h2>

        <p class="mt-4 text-gray-300 leading-relaxed">
          Engineering consultation,
          technical solutions,
          and project optimization.
        </p>

      </div>


    </div>

  </div>

</section>


</BaseLayout>